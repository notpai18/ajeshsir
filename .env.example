# Chemistry Educator Portal — Environment Variables Template
# Copy this file to .env and fill in real values

# ─── Supabase Configuration ───────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase Admin (server-side only — NEVER expose in frontend) ──────────────
# Required only for running scripts/create_professor.mjs
# Find this in: Supabase Dashboard → Settings → API → service_role secret key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Professor Seed Account (used by scripts/create_professor.mjs) ────────────
PROFESSOR_EMAIL=professor@ajeshsir.com
PROFESSOR_PASSWORD=AjeshSir@2026!
PROFESSOR_NAME=Prof. Ajesh

# ─── Existing Variables ────────────────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
